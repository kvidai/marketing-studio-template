## ============================================================
## marketing-studio — .env.example
## Copy to the correct env file and fill in real values.
##
## Files:
##   kvidai.env.production  — kvid.ai service keys
##   affy.env.production    — affy.ink service keys
##   brand.env.production   — brand social accounts / shared values
##
## Currently all variables are consolidated in .env.production.
## ============================================================

## --- AWS SES (email sending) ---
AWS_REGION=ap-northeast-2
AWS_SES_REGION=us-east-1
AWS_SES_KEY=your-access-key-id
AWS_SES_SECRET=your-secret-access-key
AWS_SEND_EMAIL=your-admin@example.com
KVIDAI_AWS_SEND_EMAIL_MARKETING=hello@em.kvid.ai
KVIDAI_AWS_SEND_EMAIL_TRANSACTIONAL=support@mail.kvid.ai
KVIDAI_ADMIN_EMAIL=admin@kvid.ai
KVIDAI_SELF_URL=https://console.kvid.ai/

## --- Resend (affy.ink email sending) ---
# RESEND_API_KEY=re_your_key
# EMAIL_FROM=noreply@affy.ink

## --- NHN Cloud (email — comment out to disable) ---
# NHN_API_URL_EMAIL=https://email.api.nhncloudservice.com
# NHN_APP_KEY_EMAIL=your-app-key
# NHN_SECRET_KEY_EMAIL=your-secret
# KVIDAI_NHN_SENDER_EMAIL_MARKETING=hello@em.affy.ink
# KVIDAI_NHN_SENDER_EMAIL_TRANSACTIONAL=support@mail.affy.ink

## --- Blog: NodeBB (add after deployment) ---
# NODEBB_BASE_URL=https://forum.kvid.ai
# NODEBB_TOKEN=your-bearer-token

## --- Blog: Discourse (add after deployment) ---
# DISCOURSE_BASE_URL=https://community.kvid.ai
# DISCOURSE_API_KEY=your-api-key
# DISCOURSE_API_USERNAME=system

## --- Meta Graph API (add after App approval) ---
# META_PAGE_ACCESS_TOKEN=your-long-lived-page-token
# META_PAGE_ID=your-facebook-page-id
# META_IG_ACCOUNT_ID=your-instagram-account-id

## --- Reddit (add after script app setup) ---
# REDDIT_CLIENT_ID=your-14-char-client-id
# REDDIT_CLIENT_SECRET=your-secret
# REDDIT_USERNAME=KvidAIBot
# REDDIT_PASSWORD=your-password
# REDDIT_USER_AGENT=marketing-studio/0.1 by u/KvidAIBot

## --- S3 Asset Upload (optional: auto-upload images/videos from body.md) ---
# AWS_S3_BUCKET=marketing-studio-assets
# AWS_S3_CDN_BASE=https://cdn.kvid.ai

## --- TestMail.app (email testing) ---
# TESTMAILAPP_MAIL_ADDR=your-inbox@inbox.testmail.app
# TESTMAILAPP_NAMESPACE=your-namespace
# TESTMAILAPP_API_KEY=your-testmail-api-key

#### API Keys for AI Features

## Replicate - for /generate-image and /generate-video
REPLICATE_API_TOKEN=your-replicate-api-token

## Deepgram - for /transcribe
DEEPGRAM_API_KEY=your-deepgram-api-key

## ElevenLabs - for voiceovers
ELEVENLABS_API_KEY=your-elevenlabs-api-key

## kvidai
KVIDAI_API_KEY=your-kvidai-api-key
KVIDAI_BASE_URL=https://api.kvid.ai
KVIDAI_AGENT_BASE_URL=https://api.kvid.ai/agent
