# Vision Checker local example config
# Copy the keys you need into your real environment or project .env file.
# Do not commit real secrets.

# Provider selection (optional defaults)
VISION_CHECKER_PROVIDER=openai-compatible
VISION_CHECKER_MODEL=anthropic/claude-haiku-4-5
VISION_CHECKER_BASE_URL=
VISION_CHECKER_API_KEY=
VISION_CHECKER_TMP_DIR=
VISION_CHECKER_PROFILE=fast
# Runtime cache controls are CLI-first; examples below document defaults.
# Default local cache: read + write enabled
# Disable cache per run: --no-cache
# Force provider despite blank-like precheck: --force-provider
# Default batch concurrency: 2

# OpenAI native provider
OPENAI_API_KEY=

# Anthropic native provider
ANTHROPIC_API_KEY=

# OpenRouter / OpenAI-compatible providers
# Example:
# VISION_CHECKER_PROVIDER=openai-compatible
# VISION_CHECKER_BASE_URL=https://openrouter.ai/api/v1
# VISION_CHECKER_API_KEY=$OPENROUTER_API_KEY
# Example cheap models:
# VISION_CHECKER_MODEL=x-ai/grok-2-vision-1212
# VISION_CHECKER_MODEL=qwen/qwen3-vl-8b-instruct
# VISION_CHECKER_MODEL=z-ai/glm-4.6v
# If OPENROUTER_API_KEY is set, the default provider becomes openai-compatible
# even when you are running this command from a Codex CLI session.
# If VISION_CHECKER_BASE_URL is empty and OPENROUTER_API_KEY is set, the checker defaults to https://openrouter.ai/api/v1.
# If VISION_CHECKER_API_KEY is empty, the checker also falls back to OPENROUTER_API_KEY.
OPENROUTER_API_KEY=sk-or-v1-3be8...

# Optional wrapper-based subprocess providers
# Example reusable Claude wrapper:
# VISION_CHECKER_CLAUDE_COMMAND='bash {{cwd}}/claude-wrapper.sh --prompt-file {{prompt_file}} --schema-file {{schema_file}} --output-file {{output_file}} --model claude-sonnet-4-20250514 -- {{image_flags}}'
VISION_CHECKER_CLAUDE_COMMAND=
VISION_CHECKER_CUSTOM_CLI_COMMAND=
